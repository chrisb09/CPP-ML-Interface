@startuml CPP_NEW_ML_Interface

' Public architecture of CPP-ML-Interface, aligned with the current headers.
' Class / component overview only: the readiness protocol is intentionally not expanded.
left to right direction
' skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam nodesep 16
skinparam ranksep 26
skinparam class {
    BackgroundColor<<abstract>> #FFF3C4
    BackgroundColor<<enum>> #E8F0FE
    BorderColor #333333
    ArrowColor #333333
    FontSize 12
}

legend bottom
  = Public architecture
  * = pure virtual
  <>-- = owns (composition)   o-- = contains
  ..> = uses / facade / instantiates
endlegend

package "Orchestrator" {

    class "MLCoupling<CouplingInput, CouplingOutput,\nLibraryInput=CI, LibraryOutput=CO>" as MLCoupling {
        + step() : int
        + train_step(step_id : long long)
        + ordered() : OrderedProxy
        + keyed() : KeyedProxy
        + set_merge_strategy(strategy : MLCouplingMergeStrategy)
        + get_application()
        + track(field : string)
        + get_history(field : string) : vector<double>
        + get_history() : map<string, vector<double>>
        + get_current(field : string) : double
        + get_current() : map<string, double>
        + create_from_config(...) : MLCoupling* {static}
        + create_from_config_string(...) : MLCoupling* {static}
        --
        - library : unique_ptr<MLCouplingLibrary<LI,LO>>
        - application : unique_ptr<MLCouplingApplication<CI,CO,LI,LO>>
        - behavior : unique_ptr<MLCouplingBehavior>
        - coupling_type : CouplingType
        - library_input : MLCouplingData<LI>*
        - library_output : MLCouplingData<LO>*
        - training_tracker : TrainingTracker
    }

    class "MLCoupling::OrderedProxy" as OrderedProxy {
        + set(data) / set_target(target)
        + inference() / get(out)
        + train(step_id) : map<string, double>
    }

    class "MLCoupling::KeyedProxy" as KeyedProxy {
        + set(key, data) / set_target(key, target)
        + inference(in_keys, out_keys) / get(key, out)
        + train(step_id, in_keys, target_keys) : map<string, double>
    }

    class "TrainingTracker" as TrainingTracker {
        + track(field : string)
        + log(step_id : long long, metrics : map<string, double>)
        + get_history(field) : vector<double>
        + get_history() : map<string, vector<double>>
        + get_current(field) : double
        + get_current() : map<string, double>
        + get_full_history() : vector<TrainingMetrics>&
        --
        - enabled_fields : set<string>
        - history : vector<TrainingMetrics>
    }

    class "TrainingMetrics" as TrainingMetrics {
        + step_id : long long
        + values : map<string, double>
    }
}

package "Library (inference backends)" {

    abstract class "MLCouplingLibrary<LibraryInput, LibraryOutput>" as MLCouplingLibrary {
        + rank : int
        + merge_strategy : MLCouplingMergeStrategy
        + set_rank(rank) / set_merge_strategy(strategy)
        + static_inference(input, output)*
        + static_train(input, target) : map<string, double>
        + get_synchronized_iterations(local) : size_t
        + flex_ordered_set(data) / set_target(target)
        + flex_ordered_inference(output) / get(output)
        + flex_ordered_train(step_id) : map<string, double>
        + flex_keyed_set(key, data) / set_target(key, target)
        + flex_keyed_inference(in_keys, out_keys, output) / get(key, output)
        + flex_keyed_train(step_id, in_keys, target_keys) : map<string, double>
    }

    class "MLCouplingLibraryPhydll" as Phydll
    class "MLCouplingLibraryAixelerator" as Aixelerator
    class "MLCouplingLibrarySmartsim" as Smartsim
    class "MLCouplingLibraryDummy" as Dummy
    class "MLCouplingLibraryGeneric" as LibraryGeneric {
        + static_inference(input, output)
        + static_train(input, target) : map<string, double>
        + get_synchronized_iterations(local) : size_t
        --
        - inference_fn : function<void(MLCouplingData<In>*, MLCouplingData<Out>*)>
        - train_fn : function<map<string,double>(...)>
        - sync_iter_fn : function<size_t(size_t)>
    }
}

note bottom of MLCouplingLibrary
  Three tiers: Tier 0 static_inference,
  Tier 1 flex_ordered_*, Tier 2 flex_keyed_*.
  Static libraries fall back to an automatic
  merge (MLCouplingMergeStrategy).
end note

note right of Phydll
  MPMD in-situ / in-transit inference over MPI.
  Options: model_file, backend=TORCH,
  device=GPU, batch_size=0,
  transport_layout auto|packed|uniform_chunks,
  solver_readiness_wait=false.
end note

note bottom of Aixelerator
  Same-type float/double only; binds first tensor.
  Options: batchsize, enable_hybrid,
  host_fraction, communication_mode
  collective|pipelined.
end note

note left of Smartsim
  Redis / SmartRedis model endpoints.
  Options: device, model_backend, model_path,
  batch_size, min_batch_size, min_batch_timeout,
  command/socket/model timeout,
  db_layout shared|per-ml-node.
end note

note right of Dummy
  Placeholder: static_inference()
  intentionally fails. Registry name "Dummy".
end note

package "Application (simulation adapters)" {

    class "MLCouplingApplication<CouplingInput, CouplingOutput,\nLibraryInput=CI, LibraryOutput=CO>" as MLCouplingApplication {
        + coupling_input : MLCouplingData<CI>
        + library_input : MLCouplingData<LI>
        + library_output : MLCouplingData<LO>
        + coupling_output : MLCouplingData<CO>
        + ml_step(library, behavior) : int
        + prepare_library_input()
        + finalize_coupling_output()
        + get_library_buffers() : pair<MLCouplingData<LI>*, MLCouplingData<LO>*>
        # preprocess_coupling_input(input) : MLCouplingData<LI>
        # postprocess_library_output(output) : MLCouplingData<CO>
        # normalization : unique_ptr<MLCouplingNormalization<LI,CO>>
    }

    class "MLCouplingApplicationFlowExtrapolator" as AppFlowEx
    class "MLCouplingApplicationGeneric" as AppGeneric {
        + ml_step(library, behavior) : int
        # preprocess_coupling_input(input) : MLCouplingData<LI>
        # postprocess_library_output(output) : MLCouplingData<CO>
        --
        - preprocess_fn / postprocess_fn
        - ml_step_fn
    }
}

note top of MLCouplingApplication
  Not abstract: same-type inputs/outputs use the
  default preprocess/postprocess passthrough.
  step -> application.ml_step -> behavior decision ->
  prepare library input -> library.static_inference ->
  finalize coupling output -> timestep delta.
  Base / Generic do NOT auto-normalize.
end note

note right of AppFlowEx
  Splits 3 raw flow fields into overlapping 3D cubes,
  assembles temporal input, reconstructs predicted fields.
  Normalizes explicitly and uses behavior.should_send_data().
  Options: cube_dimension, cube_overlap,
  input_sequence_length, forecast_window, n_ghost_layers.
end note

package "Behavior (step scheduling)" {

    abstract class "MLCouplingBehavior" as MLCouplingBehavior {
        + should_perform_inference() : bool*
        + time_step_delta() : int*
        + should_send_data() : bool*
    }

    class "MLCouplingBehaviorDefault" as BehaviorDefault
    class "MLCouplingBehaviorPeriodic" as BehaviorPeriodic {
        + should_perform_inference() : bool
        + time_step_delta() : int
        + should_send_data() : bool
        --
        - inference_interval
        - coupled_steps_before_inference
        - coupled_steps_stride
        - step_increment_after_inference
        - prohibit_inference : function<bool(int)>
    }
    class "MLCouplingBehaviorFlowExtrapolator" as BehaviorFlowEx
    class "MLCouplingBehaviorGeneric" as BehaviorGeneric {
        + should_perform_inference() : bool
        + time_step_delta() : int
        + should_send_data() : bool
        --
        - should_infer_fn / time_step_delta_fn
        - should_send_data_fn
    }
}

note bottom of BehaviorDefault
  Default when no behavior is supplied:
  infer every step, delta 0, send every step.
end note

note right of BehaviorFlowEx
  History accumulation + forecast leap-frogging.
  Options: inference_interval,
  coupled_steps_before_inference,
  step_increment_after_inference,
  hdf_output_interval, total_timesteps,
  scaling_factor, forecast_window,
  input_step_distance, inference_start_step,
  global_step_offset.
end note

note bottom of BehaviorGeneric
  Three required callbacks
  (should_infer, time_step_delta, should_send_data).
end note

package "Normalization" {

    abstract class "MLCouplingNormalization<In, Out>" as MLCouplingNormalization {
        + normalize_input(data)*
        + denormalize_output(data)*
        + print(os : ostream)*
    }

    class "MLCouplingMinMaxNormalization<In, Out>" as MinMax {
        + normalize_input(data)
        + denormalize_output(data)
        + print(os)
        --
        - input_min / input_max : In
        - output_min / output_max : Out
    }

    class "MLCouplingNormalizationGeneric<In, Out>" as NormGeneric {
        + normalize_input(data)
        + denormalize_output(data)
        + print(os)
        --
        - normalize_fn / denormalize_fn / print_fn
    }
}

package "Data model" {

    class "MLCouplingData<T>" as MLCouplingData {
        + add_tensor(tensor)
        + size() : size_t
        + empty() : bool
        + operator[](index) : MLCouplingTensor<T>&
        + flatten_all(layout) : MLCouplingData<T>
        + deep_copy() : MLCouplingData<T>
        + get_flat_data() : vector<T>
        --
        - tensors : vector<MLCouplingTensor<T>>
    }

    class "MLCouplingTensor<T>" as MLCouplingTensor {
        + wrap_flat(...) / wrap_nested(...) {static}
        + from_flat_copy(values, dims) {static}
        + dimensions() : vector<int>&
        + layout() : MLCouplingMemoryLayout
        + ownership() : MLCouplingOwnership
        + root() : void*
        + numel() : size_t
        + rank() : size_t
        + empty() / is_contiguous() / is_nested()
        + data_type() : MLCouplingDataType
        + at(index) / set(index, value)
        + at_linear(i) / set_linear(i, value)
        + flatten(layout) / unflatten(layout) / deep_copy()
        --
        - root : void*
        - dimensions : vector<int>
        - layout : MLCouplingMemoryLayout
        - ownership : MLCouplingOwnership
    }

    class "MLCouplingMatrix<T>" as Matrix
    class "MLCouplingVector<T>" as Vector
    class "MLCouplingScalar<T>" as Scalar

    enum "CouplingType" as CouplingType {
        STATIC
        FLEXIBLE
    }

    enum "MLCouplingMergeStrategy" as MergeStrategy {
        List
        Stack
        Auto
        None
    }

    enum "MLCouplingOwnership" as Ownership {
        External
        Owned
    }

    enum "MLCouplingMemoryLayout" as MemoryLayout {
        Invalid
        Nested
        Contiguous
        FortranNested
        FortranContiguous
    }

    enum "MLCouplingDataType" as DataType {
        Invalid
        Double
        Float
        Int8
        Int16
        Int32
        Int64
        Uint8
        Uint16
    }
}

note bottom of MLCouplingData
  Container ownership (owns its tensors) is distinct
  from MLCouplingTensor backing-memory policy
  (External borrow vs Owned free).
end note

package "Config / Factory" {

    enum "ConfigCastMode" as ConfigCastMode {
        Strict
        Relaxed
    }

    enum "ConfigParameterMatchMode" as ParamMatchMode {
        Strict
        Lenient
    }

    class "ConfigOverrides" as ConfigOverrides {
        + sections : ConfigSectionOverrides
        + dotted : ConfigDottedOverrides
        + empty() : bool
    }

    class "Config factory (config.hpp)" as ConfigFactory {
        + create_mlcoupling_from_config(...) : MLCoupling* {static}
        + create_mlcoupling_from_config_string(...) : MLCoupling* {static}
        + create_from_config[_file] via MLCoupling
    }
}

note bottom of ConfigFactory
  TOML -> generated_registry.hpp
  (build-time python + libclang)
  -> concrete Library / Application /
  Behavior / Normalization instances.
end note

package "Language APIs" {

    class "C API (include/c_api.h)" as CAPIC {
        + cmi_coupling_create / _create_from_config
        + cmi_coupling_step / _train_step
        + cmi_library_create_by_name / _generic
        + cmi_library_inference / _train
        + cmi_library_flex_ordered_* / flex_keyed_*
        + cmi_application_ml_step
        + cmi_behavior_create_default / periodic / generic
        + cmi_normalization_create_minmax / generic
        + opaque handles: cmi_coupling_t, cmi_library_t, ...
        + callbacks: cmi_inference_fn, cmi_should_infer_fn, ...
        + thread-local errors: cmi_get_last_error(), cmi_status_string()
        + float/double dispatch via cmi_data_type
    }

    class "Fortran module cmi (cmi_fortran.f90)" as Fortran {
        + iso_c_binding wrappers over the C API
        + opaque types: cmi_coupling, cmi_library, ...
        + cmi_tensor_wrap(1D/2D/3D float|double)
        + cmi_get_error(msg)
        + zero-copy Fortran column-major
          (CMI_LAYOUT_FORTRAN_CONTIGUOUS)
    }
}

' --- Relationships ---

' Orchestrator composition
MLCoupling "1" *-- "1" MLCouplingLibrary : owns
MLCoupling "1" *-- "1" MLCouplingApplication : owns
MLCoupling "1" *-- "0..1" MLCouplingBehavior : owns
MLCoupling "1" *-- "1" TrainingTracker : owns
MLCoupling ..> CouplingType : uses
MLCoupling ..> OrderedProxy : exposes
MLCoupling ..> KeyedProxy : exposes
MLCoupling --> MLCouplingData : library_input / library_output (borrowed)
TrainingTracker "1" o-- "0..*" TrainingMetrics : contains

' Library hierarchy and tiers
MLCouplingLibrary <|-- Phydll
MLCouplingLibrary <|-- Aixelerator
MLCouplingLibrary <|-- Smartsim
MLCouplingLibrary <|-- Dummy
MLCouplingLibrary <|-- LibraryGeneric
MLCouplingLibrary ..> MergeStrategy : uses

' Application hierarchy
MLCouplingApplication <|-- AppFlowEx
MLCouplingApplication <|-- AppGeneric
MLCouplingApplication "1" *-- "4" MLCouplingData : owns buffers
MLCouplingApplication "1" *-- "0..1" MLCouplingNormalization : owns
MLCouplingApplication ..> MLCouplingLibrary : ml_step()
MLCouplingApplication ..> MLCouplingBehavior : ml_step()

' Behavior / Normalization hierarchies
MLCouplingBehavior <|-- BehaviorDefault
MLCouplingBehavior <|-- BehaviorPeriodic
MLCouplingBehavior <|-- BehaviorFlowEx
MLCouplingBehavior <|-- BehaviorGeneric
MLCouplingNormalization <|-- MinMax
MLCouplingNormalization <|-- NormGeneric

' Data model
MLCouplingData "1" o-- "0..*" MLCouplingTensor : contains
MLCouplingTensor <|-- Matrix
MLCouplingTensor <|-- Vector
MLCouplingTensor <|-- Scalar
MLCouplingTensor ..> MemoryLayout : uses
MLCouplingTensor ..> Ownership : uses
MLCouplingTensor ..> DataType : uses

' Config / Factory
ConfigFactory ..> ConfigCastMode : uses
ConfigFactory ..> ParamMatchMode : uses
ConfigFactory ..> ConfigOverrides : uses
ConfigFactory ..> MLCouplingLibrary : instantiates
ConfigFactory ..> MLCouplingApplication : instantiates
ConfigFactory ..> MLCouplingBehavior : instantiates
ConfigFactory ..> MLCouplingNormalization : instantiates
ConfigFactory ..> MLCoupling : builds

' Language facades
CAPIC ..> MLCoupling : facade
Fortran ..> CAPIC : wraps

' Layout-only helpers (invisible edges): keep the satellite packages in a
' single column so the rendered PNG stays within PlantUML's default size limit.
MLCoupling -[hidden]-> ConfigFactory
ConfigFactory -[hidden]-> CAPIC
CAPIC -[hidden]-> Fortran
MLCouplingApplication -[hidden]-> BehaviorDefault

@enduml
